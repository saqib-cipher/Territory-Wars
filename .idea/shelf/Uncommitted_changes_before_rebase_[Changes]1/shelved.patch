+
+	public int getIconGravity() {
+		return iconGravity;
+	}
+
+	public ModernFButton setFButtonPadding(int left, int top, int right, int bottom) {
+		this.basePaddingLeft = left;
+		this.basePaddingTop = top;
+		this.basePaddingRight = right;
