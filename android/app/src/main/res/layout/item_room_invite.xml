<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Pending Room Invite Item Layout for Profile/Friends Section -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#10B981"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Inviter Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivInviteSenderAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.TerritoryWars.Avatar"
            app:srcCompat="@drawable/ic_profile" />

        <!-- Invite Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvInviteSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saqib Cipher"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInviteRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Invited you to Room #8492"
                android:textColor="#10B981"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Dismiss Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismissInvite"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:text="Dismiss"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            app:strokeColor="#475569"
            app:cornerRadius="10dp" />

        <!-- Join Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoinInvite"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="JOIN"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#10B981"
            app:cornerRadius="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
