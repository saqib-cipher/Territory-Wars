<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ── HEADER BANNER ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/gradient_hero">

        <!-- Top-Right Leave Room Button -->
        <glab.guesscard.ModernFButton
            android:id="@+id/leaveRoomButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:text="Leave"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/roomCodeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:id="@+id/roomModeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Animals Mode (1/5 Players)"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/roomCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GC-7842"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- ── WAITING STATUS BANNER ── -->
    <TextView
        android:id="@+id/tvLobbyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:padding="10dp"
        android:text="Waiting for other players to join (Need 2+ players)..."
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- ── PLAYERS IN ROOM SECTION ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:text="Connected Players (2 - 5)"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1" />

    <!-- Container for dynamic PlayerAvatarViews -->
    <LinearLayout
        android:id="@+id/playerAvatarContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp" />

    <!-- RecyclerView for detailed player status list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playersList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <!-- ── INVITE FRIENDS SECTION ── -->
    <TextView
        android:id="@+id/tvInviteFriendsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INVITE FRIENDS TO ROOM"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInviteFriends"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:scrollbars="none"
        android:layout_marginBottom="10dp" />

    <!-- ── ACTION BUTTONS ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <glab.guesscard.ModernFButton
            android:id="@+id/readyButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="I'm Ready"
            android:visibility="gone" />

        <glab.guesscard.ModernFButton
            android:id="@+id/btnStartMatch"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="START MATCH"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
