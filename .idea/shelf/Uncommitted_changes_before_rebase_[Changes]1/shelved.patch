<+><?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<!-- In-game overlay tuned for landscape. The core canvas is drawn by GameView. -->\r\n<androidx.constraintlayout.widget.ConstraintLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\r\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\r\n    android:layout_width=\"match_parent\"\r\n    android:layout_height=\"match_parent\"\r\n    android:background=\"@color/game_neutral_tile\">\r\n\r\n    <com.territorywars.game.view.GameView\r\n        android:id=\"@+id/gameView\"\r\n        android:layout_width=\"0dp\"\r\n        android:layout_height=\"0dp\"\r\n        app:layout_constraintTop_toTopOf=\"parent\"\r\n        app:layout_constraintBottom_toBottomOf=\"parent\"\r\n        app:layout_constraintStart_toStartOf=\"parent\"\r\n        app:layout_constraintEnd_toEndOf=\"parent\" />\r\n\r\n    <!-- Top HUD -->\r\n    <LinearLayout\r\n        android:id=\"@+id/hudTop\"\r\n        android:layout_width=\"0dp\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:orientation=\"horizontal\"\r\n        android:background=\"#88000000\"\r\n        android:padding=\"@dimen/space_8\"\r\n        app:layout_constraintTop_toTopOf=\"parent\"\r\n        app:layout_constraintStart_toStartOf=\"parent\"\r\n        app:layout_constraintEnd_toEndOf=\"parent\">\r\n\r\n        <TextView\r\n            android:id=\"@+id/matchTimer\"\r\n            style=\"@style/TextAppearance.TerritoryWars.TitleLarge\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:text=\"02:00\" />\r\n\r\n        <TextView\r\n            android:id=\"@+id/scoreText\"\r\n            style=\"@style/TextAppearance.TerritoryWars.TitleMedium\"\r\n            android:layout_width=\"0dp\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_weight=\"1\"\r\n            android:gravity=\"center\"\r\n            android:text=\"0 pts\" />\r\n\r\n        <TextView\r\n            android:id=\"@+id/coinCount\"\r\n            style=\"@style/TextAppearance.TerritoryWars.TitleMedium\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:text=\"\uD83E\uDE99 0\" />\r\n    </LinearLayout>\r\n\r\n    <!-- Powerup button -->\r\n    <com.google.android.material.button.MaterialButton\r\n        android:id=\"@+id/powerupButton\"\r\n        style=\"@style/Widget.Material3.Button\"\r\n        android:layout_width=\"64dp\"\r\n        android:layout_height=\"64dp\"\r\n        android:text=\"⏳\"\r\n        android:visibility=\"gone\"\r\n        app:layout_constraintEnd_toEndOf=\"parent\"\r\n        app:layout_constraintBottom_toTopOf=\"@id/pauseButton\"\r\n        android:layout_marginEnd=\"@dimen/space_16\" />\r\n\r\n    <com.google.android.material.button.MaterialButton\r\n        android:id=\"@+id/pauseButton\"\r\n        style=\"@style/Widget.Material3.Button.TonalButton\"\r\n        android:layout_width=\"64dp\"\r\n        android:layout_height=\"64dp\"\r\n        android:text=\"⏸\"\r\n        app:layout_constraintEnd_toEndOf=\"parent\"\r\n        app:layout_constraintBottom_toBottomOf=\"parent\"\r\n        android:layout_marginEnd=\"@dimen/space_16\"\r\n        android:layout_marginBottom=\"@dimen/space_16\" />\r\n\r\n    <!-- Mini map -->\r\n    <com.territorywars.game.view.MiniMapView\r\n        android:id=\"@+id/miniMap\"\r\n        android:layout_width=\"140dp\"\r\n        android:layout_height=\"140dp\"\r\n        android:background=\"#80000000\"\r\n        app:layout_constraintStart_toStartOf=\"parent\"\r\n        app:layout_constraintBottom_toBottomOf=\"parent\"\r\n        android:layout_marginStart=\"@dimen/space_16\"\r\n        android:layout_marginBottom=\"@dimen/space_16\" />\r\n\r\n    <!-- Scoreboard -->\r\n    <androidx.recyclerview.widget.RecyclerView\r\n        android:id=\"@+id/scoreboardList\"\r\n        android:layout_