<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ── HEADER ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛠️ CUSTOM MODE CREATOR"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Mode Name Input -->
    <EditText
        android:id="@+id/etModeName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1E293B"
        android:hint="Pack Name (e.g. College, Marvel...)"
        android:textColorHint="#64748B"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <!-- Question Limit & Round Timer Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etQuestionLimit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="#1E293B"
            android:hint="Q Limit (e.g. 10)"
            android:textColorHint="#64748B"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etRoundTimer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="#1E293B"
            android:hint="Timer Secs (e.g. 60)"
            android:textColorHint="#64748B"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ── CARD INPUT ROW ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cards in Pack"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etCardWord"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:hint="New Card (e.g. Professor)"
            android:textColorHint="#64748B"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <glab.guesscard.ModernFButton
            android:id="@+id/btnAddCard"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="+ Add" />

    </LinearLayout>

    <!-- Card List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <!-- Bottom Actions: Export / Save & Play -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <glab.guesscard.ModernFButton
            android:id="@+id/btnExportPack"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Export JSON" />

        <glab.guesscard.ModernFButton
            android:id="@+id/btnSaveCustomMode"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.5"
            android:layout_marginStart="8dp"
            android:text="Save &amp; Host Room 🚀" />

    </LinearLayout>

</LinearLayout>
