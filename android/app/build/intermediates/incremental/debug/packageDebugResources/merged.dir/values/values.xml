    <style name="Theme.TerritoryWars" parent="Theme.Material3.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
    <style name="Theme.TerritoryWars.Splash" parent="Theme.TerritoryWars">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Widget.TerritoryWars.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
    </style>
    <declare-styleable name="ModernFButton">
        <attr format="color" name="f_buttonColor"/>
        <attr format="color" name="f_shadowColor"/>
        <attr format="dimension" name="f_shadowHeight"/>
        <attr format="dimension" name="f_cornerRadius"/>
        <attr format="boolean" name="f_shadowEnabled"/>
        <attr format="boolean" name="f_rippleEnabled"/>
        <attr format="color" name="f_rippleColor"/>
        <attr format="reference" name="f_icon"/>
        <attr format="dimension" name="f_iconSize"/>
        <attr format="dimension" name="f_iconPadding"/>
        <attr format="color" name="f_iconTint"/>
        <attr name="f_iconGravity">
            <enum name="textStart" value="0"/>
            <enum name="textEnd" value="1"/>
            <enum name="top" value="2"/>
            <enum name="bottom" value="3"/>
            <enum name="edgeStart" value="4"/>
            <enum name="edgeEnd" value="5"/>
        </attr>
    </declare-styleable>
