<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_12">

    <TextView
        android:id="@+id/rankText"
        style="@style/TextAppearance.TerritoryWars.TitleMedium"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/playerName"
        style="@style/TextAppearance.TerritoryWars.BodyLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/rankText"
        app:layout_constraintTop_toTopOf="@id/rankText"
        app:layout_constraintEnd_toStartOf="@id/trophyText" />

    <TextView
        android:id="@+id/trophyText"
        style="@style/TextAppearance.TerritoryWars.TitleMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/rankText"
        app:layout_constraintBottom_toBottomOf="@id/rankText" />
</androidx.constraintlayout.widget.ConstraintLayout>