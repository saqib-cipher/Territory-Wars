+
+	public ModernFButton setLoadingSizeDp(float dp) {
+		this.loadingSizePx = Math.round(dp * getResources().getDisplayMetrics().density);
+		if (spinnerDrawable != null) spinnerDrawable.setBounds(0, 0, loadingSizePx, loadingSizePx);
+		return this;
