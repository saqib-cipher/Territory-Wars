<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvFriendsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FRIENDS 👥"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Notification Bell Button with Live Badge -->
        <FrameLayout
            android:id="@+id/flNotificationContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true">

            <glab.guesscard.ModernFButton
                android:id="@+id/btnFriendRequestsNotification"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:mfb_iconSrc="@drawable/users_plus"
                app:mfb_iconGravity="textStart"
                app:mfb_iconPadding="0dp"
                app:mfb_iconTint="#F59E0B"
                app:mfb_buttonColor="#1E293B"
                app:mfb_cornerRadius="12dp" />

            <TextView
                android:id="@+id/tvNotificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="18dp"
                android:minHeight="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_notification_dot"
                android:backgroundTint="#EF4444"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <glab.guesscard.ModernFButton
            android:id="@+id/btnCloseFriends"
            android:layout_width="68dp"
            android:layout_height="40dp"
            android:text="Close"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- SEARCH BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etSearchFriends"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/shape_glass_card"
            android:hint="Search by UID or username..."
            android:textColorHint="#64748B"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <glab.guesscard.ModernFButton
            android:id="@+id/btnSearch"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Search" />
    </LinearLayout>

    <!-- SEARCH RESULTS SECTION -->
    <TextView
        android:id="@+id/tvSearchResultsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEARCH RESULTS"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- MAIN FRIENDS SECTION -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFriendsContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MY FRIENDS LIST SECTION -->
            <TextView
                android:id="@+id/tvMyFriendsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MY FRIENDS"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNoFriends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E293B"
                android:padding="28dp"
                android:text="No friends added yet.\nSearch players by username or UID above to add friends!"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFriendsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
