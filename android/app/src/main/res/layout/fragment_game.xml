<?xml version="1.0" encoding="utf-8"?>
<!-- In-game overlay tuned for landscape. The core canvas is drawn by GameView. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_neutral_tile">

    <com.territorywars.game.view.GameView
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top HUD -->
    <LinearLayout
        android:id="@+id/hudTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#88000000"
        android:padding="@dimen/space_8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/matchTimer"
            style="@style/TextAppearance.TerritoryWars.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:00" />

        <TextView
            android:id="@+id/scoreText"
            style="@style/TextAppearance.TerritoryWars.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 pts" />

        <TextView
            android:id="@+id/coinCount"
            style="@style/TextAppearance.TerritoryWars.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 0" />
    </LinearLayout>

    <!-- Powerup button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/powerupButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:text="⏳"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/pauseButton"
        android:layout_marginEnd="@dimen/space_16" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pauseButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:text="⏸"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16" />

    <!-- Mini map -->
    <com.territorywars.game.view.MiniMapView
        android:id="@+id/miniMap"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="#80000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16" />

    <!-- Scoreboard -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scoreboardList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="#A0000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hudTop"
        android:layout_margin="@dimen/space_8" />

</androidx.constraintlayout.widget.ConstraintLayout>