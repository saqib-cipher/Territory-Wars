# Server config. Copy to `.env` and fill in real values.

# Node environment: development | production
NODE_ENV=development

# HTTP port for the Express + Socket.IO server
PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/territory_wars

# Redis connection string (boot dependency)
REDIS_URL=redis://localhost:6379

# JWT signing secret - use a long random value in production
JWT_SECRET=change-me-to-a-long-random-string

# Google sign-in: OAuth audience used to verify Firebase ID tokens
GOOGLE_CLIENT_ID=

# Play Developer API service account (for /purchase/verify)
# Leave empty for the dev stub that accepts any purchase token.
# Format: absolute path to the downloaded <project>-<hash>.json
GOOGLE_SERVICE_ACCOUNT_FILE=

# Play package name the app was published under
PLAY_PACKAGE_NAME=com.territorywars

# LiveKit SFU Real-Time Voice Configuration (from https://livekit.io/cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret