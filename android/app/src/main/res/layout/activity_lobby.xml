<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/gradient_hero"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/roomCodeContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/roomNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Game Room"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/roomModeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Animals Mode (1/5 Players)"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <glab.guesscard.ModernFButton
                android:id="@+id/roomCodeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:mfb_buttonColor="#8D6E63"
                app:mfb_iconSrc="@drawable/share"
                app:mfb_iconGravity="textEnd"
                app:mfb_iconSize="18dp"
                android:textSize="14dp"
                app:mfb_iconTint="#FFFFFF"
                android:text="GC-7842"
                android:textColor="#FFFFFF"
                android:layout_marginHorizontal="4dp"
                android:letterSpacing="0.10" />

            <!-- Top-Right Leave Room Button -->
            <glab.guesscard.ModernFButton
                android:id="@+id/leaveRoomButton"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                app:mfb_iconSrc="@drawable/exit_door"
                app:mfb_iconSize="20dp"
                app:mfb_iconTint="#FFFFFF"
                app:mfb_buttonColor="#EF5350" />

        </LinearLayout>

        <!-- RecyclerView for detailed player status list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playersList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- ── ACTION BUTTONS ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <glab.guesscard.ModernFButton
                android:id="@+id/readyButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="I'm Ready"
                android:visibility="gone" />

            <glab.guesscard.ModernFButton
                android:id="@+id/btnStartMatch"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="START MATCH"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Floating Invite Friends Button (Bottom Left / Center Left) -->
    <glab.guesscard.ModernFButton
        android:id="@+id/btnOpenInviteFriends"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="80dp"
        android:text="Invite Friends 👥"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:mfb_buttonColor="#2563EB"
        app:mfb_shadowColor="#1D4ED8"
        app:mfb_cornerRadius="24dp"
        app:mfb_iconSrc="@drawable/ic_friends"
        app:mfb_iconSize="18dp"
        app:mfb_iconTint="#FFFFFF" />

</FrameLayout>
