<?xml version="1.0" encoding="utf-8"?>
<!-- Item Layout for Friends in Lobby Invite Dialog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_glass_card"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <!-- Avatar with Online Dot Badge -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLobbyFriendAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.TerritoryWars.Avatar"
            app:srcCompat="@drawable/ic_profile" />

        <View
            android:id="@+id/vLobbyOnlineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/circle"
            app:tint="#10B981" />
    </FrameLayout>

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvLobbyFriendName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Friend Username"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvLobbyFriendStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🟢 Online"
            android:textColor="#10B981"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Invite Button (+ Invite -> Invited 10s cooldown) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInviteFriendAction"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:minHeight="38dp"
        android:paddingHorizontal="14dp"
        android:text="+ Invite"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="#2563EB"
        app:cornerRadius="12dp" />

</LinearLayout>
