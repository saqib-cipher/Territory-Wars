dTint=\"?attr/colorPrimaryContainer\">\r\n\r\n                <LinearLayout\r\n                    android:layout_width=\"match_parent\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:gravity=\"center_vertical\"\r\n                    android:orientation=\"horizontal\"\r\n                    android:padding=\"@dimen/space_24\">\r\n\r\n                    <ImageView\r\n                        android:id=\"@+id/rewardIcon\"\r\n                        android:layout_width=\"48dp\"\r\n                        android:layout_height=\"48dp\"\r\n                        app:srcCompat=\"@drawable/ic_shop\" />\r\n\r\n                    <LinearLayout\r\n                        android:layout_width=\"0dp\"\r\n                        android:layout_height=\"wrap_content\"\r\n                        android:layout_weight=\"1\"\r\n                        android:layout_marginStart=\"@dimen/space_16\"\r\n                        android:orientation=\"vertical\">\r\n\r\n                        <TextView\r\n                            android:id=\"@+id/rewardTitle\"\r\n                            style=\"@style/TextAppearance.TerritoryWars.TitleMedium\"\r\n                            android:layout_width=\"wrap_content\"\r\n                            android:layout_height=\"wrap_content\"\r\n                            android:text=\"@string/home_daily_reward\" />\r\n\r\n                        <TextView\r\n                            android:id=\"@+id/rewardSubtitle\"\r\n                            style=\"@style/TextAppearance.TerritoryWars.BodyMedium\"\r\n                            android:layout_width=\"wrap_content\"\r\n                            android:layout_height=\"wrap_content\"\r\n                            android:text=\"@string/home_claim\" />\r\n                    </LinearLayout>\r\n\r\n                    <com.google.android.material.button.MaterialButton\r\n                        android:id=\"@+id/claimButton\"\r\n  