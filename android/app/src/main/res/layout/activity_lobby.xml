<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ── HEADER BANNER ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/gradient_hero">

        <!-- Top-Right Leave Room Button -->
        <glab.guesscard.ModernFButton
            android:id="@+id/leaveRoomButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            app:f_iconSrc="@drawable/exit_door"
            android:text="Leave"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/roomCodeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/roomNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Game Room"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/roomCodeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GC-7842"
                        android:textColor="#8BC34A"
                        android:textSize="10sp"
                        android:layout_marginHorizontal="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />
                </LinearLayout>
                <TextView
                    android:id="@+id/roomModeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Animals Mode (1/5 Players)"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- RecyclerView for detailed player status list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playersList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- ── INVITE FRIENDS SECTION ── -->
    <TextView
        android:id="@+id/tvInviteFriendsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INVITE FRIENDS TO ROOM"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInviteFriends"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:scrollbars="none"
        android:layout_marginBottom="10dp" />

    <!-- ── ACTION BUTTONS ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <glab.guesscard.ModernFButton
            android:id="@+id/readyButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="I'm Ready"
            android:visibility="gone" />

        <glab.guesscard.ModernFButton
            android:id="@+id/btnStartMatch"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="START MATCH"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
