<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".fragments.HomeFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="96dp">

            <!-- Daily reward card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dailyRewardCard"
                style="@style/Widget.TerritoryWars.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:backgroundTint="?attr/colorPrimaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_24">

                    <ImageView
                        android:id="@+id/rewardIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:srcCompat="@drawable/ic_shop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/rewardTitle"
                            style="@style/TextAppearance.TerritoryWars.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_daily_reward" />

                        <TextView
                            android:id="@+id/rewardSubtitle"
                            style="@style/TextAppearance.TerritoryWars.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_claim" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/claimButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/home_claim" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Play -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/quickPlayButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/home_quick_play" />

            <!-- Ad banner slot (native) -->
            <FrameLayout
                android:id="@+id/homeNativeAdSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16" />

            <!-- Recent matches -->
            <TextView
                android:id="@+id/recentMatchesTitle"
                style="@style/TextAppearance.TerritoryWars.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/home_recent_matches" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentMatchesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- News banner is shown via Snackbar.make() at runtime. -->
</androidx.coordinatorlayout.widget.CoordinatorLayout>