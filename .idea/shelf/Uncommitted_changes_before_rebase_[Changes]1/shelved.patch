+	// ---------------- Loading indicator ----------------
+
+	/** Optional: customize the spinner color before calling setLoading(true). */
+	public ModernFButton setLoadingColor(int color) {
+		this.loadingColor = color;
+		if (spinnerDrawable != null) spinnerDrawable.setColor(color);
