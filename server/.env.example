# Territory Wars server environment
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080

# PostgreSQL
DATABASE_URL=postgres://twuser:twpass@localhost:5432/territory_wars

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Google (Firebase Auth / Play validation)
GOOGLE_WEB_CLIENT_ID=your-game-server-oauth-client.apps.googleusercontent.com
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# Monetisation
GOOGLE_PLAY_PACKAGE_NAME=com.territorywars
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120