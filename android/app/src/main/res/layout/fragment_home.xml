<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── HERO HEADER ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/gradient_hero">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GUESS THE CARD"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Party Game for 2 to 5 Players"
                    android:textColor="#BBFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </FrameLayout>

        <!-- ── OFFLINE PRACTICE MODE SECTION (Visible when offline) ── -->
        <LinearLayout
            android:id="@+id/offlinePracticeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Offline Mode"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:layout_marginBottom="12dp" />

            <FrameLayout
                android:id="@+id/btnOfflinePractice"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/gradient_btn_offline"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRACTICE MODE"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Play offline practice match"
                            android:textColor="#FFFFFFAA"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Practice"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ── ONLINE GAME MODES SECTION (Visible when online) ── -->
        <LinearLayout
            android:id="@+id/onlineModesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="Choose Online Mode"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12" />

            <!-- ── MODE CARDS GRID ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Animals Mode Card -->
                <FrameLayout
                    android:id="@+id/modeAnimals"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/gradient_btn_multiplayer"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ANIMALS (10 Questions)"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Play"
                            android:textColor="#FFFFFFAA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Food Mode Card -->
                <FrameLayout
                    android:id="@+id/modeFood"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/gradient_btn_offline"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="FOOD &amp; DISHES (8 Questions)"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Play"
                            android:textColor="#FFFFFFAA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Countries Mode Card -->
                <FrameLayout
                    android:id="@+id/modeCountries"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/gradient_btn_multiplayer"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="COUNTRIES (10 Questions)"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Play"
                            android:textColor="#FFFFFFAA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Celebrities Mode Card -->
                <FrameLayout
                    android:id="@+id/modeCelebrities"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/gradient_hero"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CELEBRITIES (12 Questions)"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Play"
                            android:textColor="#FFFFFFAA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Custom Mode Creator Card -->
                <FrameLayout
                    android:id="@+id/modeCustom"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/gradient_btn_offline"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CUSTOM MODE CREATOR"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Create"
                            android:textColor="#FFFFFFAA"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
