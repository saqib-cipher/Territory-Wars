<?xml version="1.0" encoding="utf-8"?>
<!-- Player row inside Match Details Dialog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_glass_card"
    android:padding="10dp"
    android:layout_marginBottom="6dp">

    <!-- Rank Badge -->
    <TextView
        android:id="@+id/tvPlayerRank"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/circle"
        android:backgroundTint="#334155"
        android:gravity="center"
        android:text="#1"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPlayerAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TerritoryWars.Avatar"
        app:srcCompat="@drawable/ic_profile" />

    <!-- Name & Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Player Name"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvPlayerQuestionsUsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Questions: 4"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Score Badge -->
    <TextView
        android:id="@+id/tvPlayerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_glass_card"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="540 pts"
        android:textColor="#F59E0B"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
